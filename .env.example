# Spotify Developer App: https://developer.spotify.com/dashboard
# Redirect URIs (add both in Spotify Dashboard → Settings):
#   http://localhost:3000/api/auth/callback/spotify
#   https://YOUR_VERCEL_DOMAIN/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional on Vercel (auto-set from VERCEL_URL). Required for custom domains:
# AUTH_URL=https://your-domain.vercel.app

# Discogs personal access token: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Optional: Last.fm API key (free) for similar-artist and genre-tag enrichment
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# MusicBrainz and Apple Music (iTunes Search API) need no key — used automatically.

# Database — free local file (no signup required)
DATABASE_URL=file:./data/record_finder.db

# Optional: Turso free tier for persistent credits/orders on Vercel
# https://turso.tech (free — no credit card required)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Required for the daily price-snapshot cron (/api/cron/snapshot-prices) to
# accept requests — Vercel sends this as `Authorization: Bearer <value>` when
# invoking a scheduled cron job. Generate with: openssl rand -base64 32
# Also set this in the Vercel project's environment variables once deployed.
CRON_SECRET=

# Optional: Resend (https://resend.com) for wishlist price-drop email alerts.
# Without RESEND_API_KEY, the cron job still snapshots prices — it just skips
# sending alerts (logs a warning instead of failing). Note: like any
# transactional email provider, sending to real users (not just your own
# Resend-verified test address) requires verifying a sending domain with
# Resend — that's a one-time setup outside this repo, not a code change.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=alerts@yourdomain.com

# Optional: absolute site URL used in price-drop alert email links. Defaults
# to localhost for local dev; set to your real domain once deployed.
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional: gates the internal success-metrics dashboard at /dashboard to the
# one signed-in email that matches — everyone else (including guests) gets a
# generic not-found response. There's no admin/role system in this app, so
# this is the whole access-control mechanism. Set to whatever email your own
# Spotify account signs in with.
# ADMIN_EMAIL=you@example.com
